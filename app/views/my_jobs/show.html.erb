<%# app/views/my_jobs/show.html.erb %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center mb-6">
    <%= link_to my_jobs_path, class: "text-blue-600 hover:text-blue-800 mr-4" do %>
      <i class="fas fa-arrow-left"></i> Back to My Jobs
    <% end %>
    <h1 class="text-2xl font-bold">Job Details</h1>
  </div>
  
  <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
    <div class="p-6">
      <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-6">
        <div>
          <h2 class="text-xl font-semibold"><%= @property.address %></h2>
          <p class="text-gray-600"><%= @job.date.strftime("%B %d, %Y") %></p>
        </div>
        
        <div class="mt-4 md:mt-0">
          <div class="flex items-center">
            <div class="mr-4">
              <div class="flex items-center">
                <div class="w-24 bg-gray-200 rounded-full h-2.5 mr-2">
                  <div class="bg-blue-600 h-2.5 rounded-full" style="width: <%= @job.completion_percentage %>%"></div>
                </div>
                <span class="text-sm font-medium text-gray-700"><%= @job.completion_percentage %>%</span>
              </div>
            </div>
            
            <% if @job.completion_percentage == 100 %>
              <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">
                Completed
              </span>
            <% else %>
              <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-medium">
                In Progress
              </span>
            <% end %>
          </div>
        </div>
      </div>
      
      <% if @job.job_assignments.exists?(subcontractor: Current.user) %>
        <div class="mb-6 p-4 bg-gray-50 rounded-lg">
          <h3 class="text-md font-medium mb-2">Assignment Information</h3>
          <p class="text-gray-700">
            <% assignment = @job.job_assignments.find_by(subcontractor: Current.user) %>
            You were assigned to this job by <%= assignment.assigned_by.email_address %>.
            <% if assignment.notes.present? %>
              <div class="mt-2">
                <h4 class="text-sm font-medium">Notes:</h4>
                <p class="text-sm text-gray-700 p-2 bg-white rounded mt-1"><%= assignment.notes %></p>
              </div>
            <% end %>
          </p>
        </div>
      <% end %>
      
      <div class="border-t border-gray-200 pt-6">
        <% if @job_sections.empty? %>
          <p class="text-gray-600 text-center py-4">No tasks have been added to this job yet.</p>
        <% else %>
          <% @job_sections.each do |section| %>
            <div class="mb-8">
              <h3 class="text-lg font-semibold mb-4"><%= section.title %></h3>
              
              <% section.job_section_groups.each do |group| %>
                <div class="mb-6">
                  <h4 class="font-medium text-gray-700 mb-3"><%= group.title %></h4>
                  
                  <div class="space-y-3">
                    <% group.job_tasks.each do |task| %>
                      <div class="flex items-start">
                        <div class="mr-3 mt-0.5">
                          <% if task.completed %>
                            <div class="w-5 h-5 rounded-full bg-green-500 flex items-center justify-center">
                              <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                              </svg>
                            </div>
                          <% else %>
                            <div class="w-5 h-5 rounded-full border-2 border-gray-300"></div>
                          <% end %>
                        </div>
                        <span class="<%= task.completed ? 'line-through text-gray-500' : 'text-gray-700' %>">
                          <%= task.title %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>