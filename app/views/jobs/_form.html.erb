<%# app/views/jobs/_form.html.erb %>
<%= form_with model: [@organization, @property, @job], class: "max-w-lg my-3 p-6 bg-white rounded-lg shadow-md" do |f| %>
  <% if @job.errors.any? %>
    <div class="mb-6 p-4 border border-red-200 bg-red-50 rounded-md text-red-700">
      <h4 class="text-lg font-medium mb-2"><%= pluralize(@job.errors.count, "error") %> prevented this job from being saved:</h4>
      <ul class="list-disc pl-5 space-y-1">
        <% @job.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= f.label :date, "Cleaning Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.date_field :date, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="mb-6">
    <%= f.label :checklist_id, "Checklist Template", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <% if @property.default_checklist_id.present? %>
      <div class="mb-3 text-sm text-gray-600 bg-blue-50 p-3 rounded-md">
        <span class="font-medium">Default checklist:</span> <%= @organization.checklists.find(@property.default_checklist_id).title %>
      </div>
    <% end %>
    
    <%= f.collection_select :checklist_id, 
                           @checklists, 
                           :id, 
                           :title, 
                           { 
                             selected: @property.default_checklist_id, 
                             include_blank: "Select a checklist" 
                           }, 
                           { 
                             class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white",
                             required: true
                           } %>
  </div>

  <div>
    <%= f.submit "Create Job", class: "w-full py-2 px-4 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200" %>
  </div>
<% end %>