<!-- app/views/jobs/_job.html.erb -->
<div id="job_<%= job.id %>" class="mb-4 border border-gray-200 rounded-lg overflow-hidden shadow-sm">
  <%= link_to organization_property_job_path(organization, property, job), class: "block hover:bg-gray-50" do %>
    <div class="p-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center">
          <i class="fas fa-calendar text-gray-600 mr-2"></i>
          <span class="text-gray-900 font-medium"><%= job.date.strftime("%Y-%m-%d") %></span>
          <span class="ml-3 px-2 py-1 text-xs font-semibold rounded-full
                      <%= job.status == 'scheduled' ? 'bg-blue-100 text-blue-800' :
                         job.status == 'completed' ? 'bg-green-100 text-green-800' :
                         'bg-yellow-100 text-yellow-800' %>">
            <%= job.status.humanize %>
          </span>
        </div>
        <div class="flex items-center">
          <span class="text-sm text-gray-600 mr-3">
            <%= job.completed_tasks %>/<%= job.total_tasks %> tasks completed
          </span>
          <i class="fas fa-chevron-right text-gray-400"></i>
        </div>
      </div>
    </div>
  <% end %>
  
  <% if Current.user.role_in(organization) == "admin" %>
    <div class="px-4 pb-4 border-t border-gray-200 mt-1">
      <div class="mt-3">
        <h4 class="text-sm font-medium text-gray-700 mb-2">Assign Member</h4>
        
        <% if job.assigned_to.present? %>
          <div class="flex items-center justify-between mb-3 py-2 px-3 bg-gray-50 rounded">
            <div class="flex items-center">
              <i class="fas fa-user text-gray-500 mr-2"></i>
              <span class="text-sm"><%= job.assigned_to.user.email_address %></span>
              <span class="ml-2 text-xs text-gray-500">(<%= job.assigned_to.role.humanize %>)</span>
            </div>
            <%= button_to unassign_organization_property_job_path(organization, property, job), 
                method: :delete, 
                class: "text-red-600 hover:text-red-800" do %>
              <i class="fas fa-times"></i>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 italic mb-3">No one assigned yet</p>
        <% end %>
        
        <%= form_with url: assign_organization_property_job_path(organization, property, job), 
                      method: :post, 
                      class: "flex items-center" do |f| %>
          <div class="flex-grow">
            <%= f.select :membership_id, 
                organization.memberships.map { |m| [m.user.email_address + " (#{m.role})", m.id] },
                { include_blank: "Select member..." },
                { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 text-sm" } %>
          </div>
          <%= f.submit "Assign", class: "ml-2 inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>